{
  "name": "goeasyerp",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.0",
  "publisher": "erp-development",
  "author": "ERP Development AS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hansjlachmann/goeasyerp-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/hansjlachmann/goeasyerp-vscode/issues"
  },
  "homepage": "https://github.com/hansjlachmann/goeasyerp-vscode#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1F2933",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "goeasyerp",
    "erp",
    "go"
  ],
  "engines": {
    "vscode": "^1.136.0"
  },
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/ThirdPartyNotices.txt",
    "media/icon.png",
    "package.nls.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "activationEvents": [
    "workspaceContains:**/application.yaml",
    "onTaskType:goeasyerp",
    "onDebugResolve:goeasyerp",
    "onDebugInitialConfigurations"
  ],
  "extensionDependencies": [
    "golang.go",
    "redhat.vscode-yaml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "goeasyerp.createContainer",
        "title": "%command.createContainer%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.startContainer",
        "title": "%command.startContainer%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.stopContainer",
        "title": "%command.stopContainer%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.removeContainer",
        "title": "%command.removeContainer%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.newApp",
        "title": "%command.newApp%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.downloadBase",
        "title": "%command.downloadBase%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.compile",
        "title": "%command.compile%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.packageApp",
        "title": "%command.packageApp%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.unpublishApp",
        "title": "%command.unpublishApp%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.nextObjectNo",
        "title": "%command.nextObjectNo%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.nextFieldNo",
        "title": "%command.nextFieldNo%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.openBrowser",
        "title": "%command.openBrowser%",
        "category": "GoEasyERP"
      },
      {
        "command": "goeasyerp.showOutput",
        "title": "%command.showOutput%",
        "category": "GoEasyERP"
      }
    ],
    "taskDefinitions": [
      {
        "type": "goeasyerp",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "compile"
            ],
            "description": "%task.compile%"
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "goeasyerp",
        "label": "%debugger.label%",
        "configurationAttributes": {
          "launch": {
            "required": [
              "server",
              "user"
            ],
            "properties": {
              "server": {
                "type": "string",
                "default": "http://localhost:8080",
                "description": "%launch.server%"
              },
              "company": {
                "type": "string",
                "default": "main",
                "description": "%launch.company%"
              },
              "user": {
                "type": "string",
                "default": "ADMIN",
                "description": "%launch.user%"
              },
              "startupPageId": {
                "type": "integer",
                "minimum": 1,
                "default": 22,
                "description": "%launch.startupPageId%"
              },
              "openBrowser": {
                "type": "boolean",
                "default": true,
                "description": "%launch.openBrowser%"
              },
              "schemaUpdateMode": {
                "type": "string",
                "enum": [
                  "synchronize",
                  "recreate"
                ],
                "default": "synchronize",
                "description": "%launch.schemaUpdateMode%"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "goeasyerp",
            "request": "launch",
            "name": "Local container",
            "server": "http://localhost:8080",
            "company": "main",
            "user": "ADMIN",
            "startupPageId": 22,
            "openBrowser": true,
            "schemaUpdateMode": "synchronize"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.label%",
            "description": "%debugger.snippet%",
            "body": {
              "type": "goeasyerp",
              "request": "launch",
              "name": "Local container",
              "server": "http://localhost:8080",
              "company": "main",
              "user": "ADMIN",
              "startupPageId": 22,
              "openBrowser": true,
              "schemaUpdateMode": "synchronize"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "@types/vscode": "~1.136.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "tar": "^7.5.23",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
